# RPC endpoint (devnet dulu untuk uji, mainnet-beta untuk live)
RPC_URL=https://api.devnet.solana.com
# Wallet: base58 private key ATAU JSON array 64 angka (jangan commit file .env asli)
WALLET_SECRET_KEY=
# DLMM pool address (base58, 32 byte)
POOL_ADDRESS=
# Total deploy per rebalance dalam SOL, dipakai saat belum ada posisi
# (modal awal) dan fallback bila posisi kosong
DEPLOY_SOL=0.05
# Jumlah bin tiap sisi active bin saat open, 0..35 (0 = 1 bin tunggal)
BINS_EACH_SIDE=10
# Spot | BidAsk | Curve
STRATEGY=Spot
# Poll interval ms, minimal 5000
POLL_INTERVAL_MS=30000
# Slippage bps (saat ini disimpan untuk tahap Jupiter swap leg)
SLIPPAGE_BPS=100
# true = tidak kirim tx, hanya log keputusan
DRY_RUN=true
# Jupiter Swap API v2 key untuk swap leg (wajib bila BINS_EACH_SIDE > 0 dan live)
JUPITER_API_KEY=
# true = range lebar swap setengah SOL ke token pasangan sebelum open
SWAP_ENABLED=true
# commitment solana: confirmed | finalized | processed
COMMITMENT=confirmed
# Telegram (opsional, kosongkan TELEGRAM_BOT_TOKEN untuk menonaktifkan)
# 1. Chat ke @BotFather -> /newbot -> copy token ke bawah
# 2. Chat ke bot kamu -> /start, lalu buka https://api.telegram.org/bot<TOKEN>/getUpdates untuk lihat chat id
#    atau chat ke @userinfobot untuk dapat id. Boleh lebih dari satu, pisahkan koma.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = kirim juga pesan "Hold" tiap tick ke Telegram (default false, hanya Rebalance + error + status online)
TELEGRAM_NOTIFY_HOLD=false
